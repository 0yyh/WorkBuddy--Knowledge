# B2 发布签名 —— 模板（复制为 keystore.properties 后填入真实值，该文件已被 .gitignore 忽略，不会入库）
#
# 生成发布密钥（在仓库外执行，密钥属凭证，切勿提交/泄露）：
#   keytool -genkey -v -keystore release.keystore -alias pks \
#           -keyalg RSA -keysize 2048 -validity 10000
#
# 然后把本文件另存为同目录 keystore.properties，填入下方真实值。
# build.gradle 检测到 keystore.properties 存在即自动对 release 包签名；
# 缺失则该文件时 assembleRelease 产出未签名包（不报错）。

# 密钥库相对路径（相对本 android 目录）
STORE_FILE=release.keystore
# 密钥库密码
STORE_PASSWORD=change_me
# 别名
KEY_ALIAS=pks
# 别名密码
KEY_PASSWORD=change_me
